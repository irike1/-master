#include "led.h"

/ {

    /* Input‑event codes and MATRIX_KEY helper macros */
    #include <zephyr/dt-bindings/input/input-event-codes.h>
    #include <zephyr/dt-bindings/input/keymap.h>

    /* External keyboard matrix */
    kbd_matrix: keypad {
        compatible = "gpio-kbd-matrix";

        /* ── Row GPIOs: P1.05 P0.23 P1.06 P0.19 P0.03 P0.02 P0.07 (inputs, pull‑up, active‑low) ── */
        row-gpios =
            <&gpio1 04 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio1 05 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio0 07 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio0 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio0 07 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
            <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

        /* ── Column GPIOs: P0.25 P0.22 P0.26 P0.24 P0.20 P1.08 P0.06 P1.00 P1.01 P0.05 P0.04 P1.11 P0.31 P0.30 P1.10 P0.29 P0.28 (outputs, active‑low) ── */
        col-gpios =
            <&gpio1 06 GPIO_ACTIVE_LOW>,
            <&gpio1 07 GPIO_ACTIVE_LOW>,
            <&gpio0 25 GPIO_ACTIVE_LOW>,
            <&gpio0 22 GPIO_ACTIVE_LOW>,
            <&gpio0 26 GPIO_ACTIVE_LOW>,
            <&gpio0 24 GPIO_ACTIVE_LOW>,
            <&gpio0 20 GPIO_ACTIVE_LOW>,
            <&gpio1  8 GPIO_ACTIVE_LOW>,
            <&gpio0 06 GPIO_ACTIVE_LOW>,
            <&gpio1 00 GPIO_ACTIVE_LOW>,
            <&gpio1  1 GPIO_ACTIVE_LOW>,
            <&gpio0  5 GPIO_ACTIVE_LOW>,
            <&gpio0  4 GPIO_ACTIVE_LOW>,
            <&gpio1 11 GPIO_ACTIVE_LOW>,
            <&gpio0 31 GPIO_ACTIVE_LOW>,
            <&gpio0 30 GPIO_ACTIVE_LOW>,
            <&gpio1 10 GPIO_ACTIVE_LOW>;
    
     keymap: keymap {
            compatible = "input-keymap";
            row-size = <6>;
            col-size = <17>;
    

            /* keymap property – one MATRIX_KEY per switch, tokens separated by spaces */
            keymap = <
                MATRIX_KEY(0,  1, INPUT_KEY_F13)
                MATRIX_KEY(0,  2, INPUT_KEY_F14)
                MATRIX_KEY(0,  3, INPUT_KEY_F15)
                MATRIX_KEY(0,  4, INPUT_KEY_F16)
                MATRIX_KEY(0, 10, 165)   /* Previous Track */
                MATRIX_KEY(0, 11, 164)   /* Play / Pause  */
                MATRIX_KEY(0, 12, 163)   /* Next Track    */
                MATRIX_KEY(0, 13, INPUT_KEY_MUTE)

                MATRIX_KEY(1,  0, INPUT_KEY_ESC)
                MATRIX_KEY(1,  1, INPUT_KEY_F1)
                MATRIX_KEY(1,  2, INPUT_KEY_F2)
                MATRIX_KEY(1,  3, INPUT_KEY_F3)
                MATRIX_KEY(1,  4, INPUT_KEY_F4)
                MATRIX_KEY(1,  6, INPUT_KEY_F5)
                MATRIX_KEY(1,  7, INPUT_KEY_F6)
                MATRIX_KEY(1,  8, INPUT_KEY_F7)
                MATRIX_KEY(1,  9, INPUT_KEY_F8)
                MATRIX_KEY(1, 10, INPUT_KEY_F9)
                MATRIX_KEY(1, 11, INPUT_KEY_F10)
                MATRIX_KEY(1, 12, INPUT_KEY_F11)
                MATRIX_KEY(1, 13, INPUT_KEY_F12)
                MATRIX_KEY(1, 14, INPUT_KEY_PRINT)
                MATRIX_KEY(1, 15, INPUT_KEY_SCROLLLOCK)
                MATRIX_KEY(1, 16, INPUT_KEY_PAUSE)

                MATRIX_KEY(2,  0, INPUT_KEY_GRAVE)
                MATRIX_KEY(2,  1, INPUT_KEY_1)
                MATRIX_KEY(2,  2, INPUT_KEY_2)
                MATRIX_KEY(2,  3, INPUT_KEY_3)
                MATRIX_KEY(2,  4, INPUT_KEY_4)
                MATRIX_KEY(2,  5, INPUT_KEY_5)
                MATRIX_KEY(2,  6, INPUT_KEY_6)
                MATRIX_KEY(2,  7, INPUT_KEY_7)
                MATRIX_KEY(2,  8, INPUT_KEY_8)
                MATRIX_KEY(2,  9, INPUT_KEY_9)
                MATRIX_KEY(2, 10, INPUT_KEY_0)
                MATRIX_KEY(2, 11, INPUT_KEY_MINUS)
                MATRIX_KEY(2, 12, INPUT_KEY_EQUAL)
                MATRIX_KEY(2, 13, INPUT_KEY_BACKSPACE)
                MATRIX_KEY(2, 14, INPUT_KEY_INSERT)
                MATRIX_KEY(2, 15, INPUT_KEY_HOME)
                MATRIX_KEY(2, 16, INPUT_KEY_PAGEUP)

                /* Row 3 */
                MATRIX_KEY(3,  0, INPUT_KEY_TAB)
                MATRIX_KEY(3,  1, INPUT_KEY_Q)
                MATRIX_KEY(3,  2, INPUT_KEY_W)
                MATRIX_KEY(3,  3, INPUT_KEY_E)
                MATRIX_KEY(3,  4, INPUT_KEY_R)
                MATRIX_KEY(3,  5, INPUT_KEY_T)
                MATRIX_KEY(3,  6, INPUT_KEY_Y)
                MATRIX_KEY(3,  7, INPUT_KEY_U)
                MATRIX_KEY(3,  8, INPUT_KEY_I)
                MATRIX_KEY(3,  9, INPUT_KEY_O)
                MATRIX_KEY(3, 10, INPUT_KEY_P)
                MATRIX_KEY(3, 11, INPUT_KEY_LEFTBRACE)
                MATRIX_KEY(3, 12, INPUT_KEY_RIGHTBRACE)
                MATRIX_KEY(3, 13, INPUT_KEY_BACKSLASH)
                MATRIX_KEY(3, 14, INPUT_KEY_DELETE)
                MATRIX_KEY(3, 15, INPUT_KEY_END)
                MATRIX_KEY(3, 16, INPUT_KEY_PAGEDOWN)

                // /* Row 4 */
                // MATRIX_KEY(4,  0, INPUT_KEY_CAPSLOCK)
                // MATRIX_KEY(4,  1, INPUT_KEY_A)
                // MATRIX_KEY(4,  2, INPUT_KEY_S)
                // MATRIX_KEY(4,  3, INPUT_KEY_D)
                // MATRIX_KEY(4,  4, INPUT_KEY_F)
                // MATRIX_KEY(4,  5, INPUT_KEY_G)
                // MATRIX_KEY(4,  6, INPUT_KEY_H)
                // MATRIX_KEY(4,  7, INPUT_KEY_J)
                // MATRIX_KEY(4,  8, INPUT_KEY_K)
                // MATRIX_KEY(4,  9, INPUT_KEY_L)
                // MATRIX_KEY(4, 10, INPUT_KEY_SEMICOLON)
                // MATRIX_KEY(4, 11, INPUT_KEY_APOSTROPHE)
                // MATRIX_KEY(4, 12, INPUT_KEY_ENTER)

                // /* Row 5 */
                // MATRIX_KEY(5,  0, INPUT_KEY_LEFTSHIFT)
                // MATRIX_KEY(5,  1, INPUT_KEY_Z)
                // MATRIX_KEY(5,  2, INPUT_KEY_X)
                // MATRIX_KEY(5,  3, INPUT_KEY_C)
                // MATRIX_KEY(5,  4, INPUT_KEY_V)
                // MATRIX_KEY(5,  5, INPUT_KEY_B)
                // MATRIX_KEY(5,  6, INPUT_KEY_N)
                // MATRIX_KEY(5,  7, INPUT_KEY_M)
                // MATRIX_KEY(5,  8, INPUT_KEY_COMMA)
                // MATRIX_KEY(5,  9, INPUT_KEY_DOT)
                // MATRIX_KEY(5, 10, INPUT_KEY_SLASH)
                // MATRIX_KEY(5, 11, INPUT_KEY_RIGHTSHIFT)
                // MATRIX_KEY(5, 15, INPUT_KEY_UP)

                /* Row 6 */
                // MATRIX_KEY(6,  0, INPUT_KEY_LEFTCTRL)
                // MATRIX_KEY(6,  1, INPUT_KEY_LEFTMETA)
                // MATRIX_KEY(6,  2, INPUT_KEY_LEFTALT)
                // MATRIX_KEY(6,  5, INPUT_KEY_SPACE)
                // MATRIX_KEY(6,  8, INPUT_KEY_RIGHTALT)
                // MATRIX_KEY(6, 10, INPUT_KEY_MENU)
                // MATRIX_KEY(6, 11, INPUT_KEY_RIGHTCTRL)
                // MATRIX_KEY(6, 12, INPUT_KEY_F17)
                // MATRIX_KEY(6, 14, INPUT_KEY_LEFT)
                // MATRIX_KEY(6, 15, INPUT_KEY_DOWN)
                // MATRIX_KEY(6, 16, INPUT_KEY_RIGHT)
            >;
        };
    };
    aliases {
        kbd = &kbd_matrix;   /* Correctly alias the keypad node */
    };
};

/ {
    leds {
        compatible = "gpio-leds";

        ext_led1: led1 {
            gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
            label = "Ext LED1";
        };
    };

    aliases {
        led1 = &ext_led1;   /* lets application use DT_ALIAS(led1) */
    };
};

&pinctrl {
	i2s0_default_alt: i2s0_default_alt {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 15)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 12)>,
				<NRF_PSEL(I2S_SDOUT, 1, 13)>,
				<NRF_PSEL(I2S_SDIN, 1, 14)>;
		};
	};
};

&i2s0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&i2s0_default_alt>;
	pinctrl-names = "default";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-i2s";
		reg = <0>;                        /* required by binding */
		chain-length = <4>;
		color-mapping = <LED_COLOR_ID_GREEN
				         LED_COLOR_ID_RED
				         LED_COLOR_ID_BLUE
                         LED_COLOR_ID_WHITE
                         LED_COLOR_ID_AMBER>;
		reset-delay = <5>;
        		/* --- precise timing --- */
		lrck-period  = <10>;   /* 10 µs word  → 1.25 µs/bit */
		nibble-zero  = <0x08>; /* 1000 → 0.3125 µs HIGH  */
		nibble-one   = <0x0E>; /* 1110 → 0.9375 µs HIGH  */
		reset-delay  = <300>;  /* ≥280 µs latch pause    */
	};
};

&{/aliases} {
	led-strip = &led_strip;
};