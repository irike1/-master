cmake:
  board:
    name: 'g915'
    path:
     - 'C:/my_boards/boards/nordic/g915'
    qualifiers: 'nrf5340/cpuapp'
    revision: ''
  images:
   - name: 'master'
     source-dir: 'C:/All/code/nrf/master'
     type: 'MAIN'
  kconfig:
    files:
     - 'C:/All/code/nrf/master/build_2/_sysbuild/empty.conf'
     - 'C:/All/code/nrf/master/build_2/_sysbuild/empty.conf'
    user-files:
     - 'C:/All/code/nrf/master/build_2/_sysbuild/empty.conf'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\b8b84efebd\opt\bin\Scripts\west build --build-dir c:/All/code/nrf/master/build_2 c:/All/code/nrf/master --pristine --board g915/nrf5340/cpuapp --sysbuild -- -DBOARD_ROOT=c:/my_boards'
  topdir: 'c:\ncs\v3.1.0'
  version: '1.4.0'
